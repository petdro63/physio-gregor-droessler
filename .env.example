PORT=3180
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3180
DEMO_MODE=true
# Internet demo only: NODE_ENV=production, DEMO_MODE=true, HOSTED_DEMO=true,
# APP_ORIGIN=https://training.physio-lfd.de; leave DATA_DIR unset.
# Keep the following values in the host's secret settings, never in Git.
HOSTED_DEMO=false
DEMO_ACCESS_USER=
DEMO_ACCESS_PASSWORD_HASH=
# Production: set DEMO_MODE=false, HTTPS origin, NODE_ENV=production.
# Initial admin is created with npm run setup; credentials never enter source.
# Optional production TOTP encryption key: 64 hexadecimal characters.
TOTP_ENCRYPTION_KEY=
# Supply only to backup/restore process, never to a browser.
BACKUP_PASSPHRASE=
