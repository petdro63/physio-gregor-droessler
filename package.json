{
  "name": "physio-gregor-droessler",
  "version": "0.1.31-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-auto-update.mjs",
    "dev:manual": "node server/index.mjs",
    "build": "node scripts/prepare-public.mjs && tsc --noEmit && vite build",
    "start": "node server/index.mjs --production",
    "test": "node scripts/build-firebase-demo.mjs --seed-only && node --test test/*.test.mjs",
    "build:firebase": "node scripts/build-firebase-demo.mjs && tsc --noEmit && vite build --mode firebase",
    "test:firebase-rules": "node scripts/test-firebase-rules.mjs",
    "deploy:firebase": "npm run build:firebase && npx -y firebase-tools@latest deploy --only hosting,firestore,auth --project physio-lfd-training",
    "seed:firebase": "node scripts/seed-firebase-demo.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/backup.mjs --restore",
    "setup": "node scripts/setup.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "file-type": "^21.0.0",
    "firebase": "^13.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.539.0",
    "multer": "^2.0.2",
    "otpauth": "^9.4.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.5",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.1",
    "@vitejs/plugin-react": "^5.0.0",
    "supertest": "^7.1.4",
    "three": "^0.186.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
